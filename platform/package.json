{
  "name": "@aetherforge/studio",
  "version": "1.0.0",
  "description": "AetherForge Studio — Autonomous AI Full-Stack Software Engineering Platform powered by REA Runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/qrcode": "^1.5.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "isomorphic-git": "^1.38.7",
    "lucide-react": "^0.511.0",
    "pg": "^8.15.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sql.js": "^1.13.0",
    "ws": "^8.18.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.15.18",
    "@types/pg": "^8.11.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
