# ==============================================================================
# AetherForge Studio — Environment Configuration Example
# Copy to `.env` (never commit `.env`, `.master.key`, or `data/*.sqlite` to Git)
# ==============================================================================

# Server Network & Mode
HOST=0.0.0.0
PORT=4100
NODE_ENV=development

# Persistent Storage Paths (defaults resolve inside ./data)
# AETHERFORGE_DATA_DIR=/home/user/rea/platform/data
# AETHERFORGE_DB_PATH=/home/user/rea/platform/data/aetherforge.sqlite

# 32-byte (or >=32 chars) AES-256-GCM Master Key for encrypting secrets & API keys
# Leave unset in dev to auto-generate ./data/.master.key (0600 permissions)
# AETHERFORGE_MASTER_KEY=replace-with-a-64-hex-char-or-32-plus-char-secret-key

# Optional PostgreSQL Connection String (status surfaced in /api/health)
# DATABASE_URL=postgres://aetherforge:change-me@localhost:5432/aetherforge

# Multi-Agent Orchestration & Sandbox Port Allocation
AETHERFORGE_MAX_ITERATIONS=40
AETHERFORGE_BUILD_TIMEOUT_MS=180000
AETHERFORGE_SANDBOX_BASE_PORT=4600
AETHERFORGE_DEPLOY_BASE_PORT=5600

# Optional Global GitHub Fallback Token (Users can also store encrypted PATs in Settings)
# GITHUB_TOKEN=ghp_your_token_here

# Optional External LLM Keys (Users can also store encrypted keys per provider in Settings)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...

# Optional External Cloud Deployment Provider Credentials
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=
# FLY_API_TOKEN=
# RAILWAY_TOKEN=
# RENDER_API_KEY=
# CLOUDFLARE_API_TOKEN=

# Optional Payment Gateway Credentials (or configure encrypted keys in /billing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

